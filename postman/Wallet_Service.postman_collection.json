          "name": "Create User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.walletId) {",
                  "    pm.collectionVariables.set('walletId', json.walletId);",
                  "}",
                  "if (json.userId) {",
                  "    pm.collectionVariables.set('userId', json.userId);",
                  "}",
                  "pm.test('walletId present', function () {",
                  "    pm.expect(json.walletId).to.be.ok;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Sharma\",\n  \"email\": \"alice@example.com\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Bangalore\",\n  \"maxBalance\": 50000.00\n}"
